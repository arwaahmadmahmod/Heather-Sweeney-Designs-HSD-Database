SEMINAR" target="CONTACT"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e219" value="ON UPDATE NO ACTION&#xa;ON DELETE CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;exitX=0;exitY=0.85;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;strokeColor=#44546A;strokeWidth=1.4;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="CUSTOMER" target="CONTACT"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e220" value="ON UPDATE NO ACTION&#xa;ON DELETE NO ACTION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;strokeColor=#44546A;strokeWidth=1.4;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="CUSTOMER" target="INVOICE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e221" value="ON UPDATE NO ACTION&#xa;ON DELETE CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;startSize=10;endSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;strokeColor=#44546A;strokeWidth=1.4;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="INVOICE" target="LINE_ITEM"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e222" value="ON UPDATE CASCADE&#xa;ON DELETE NO ACTION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;strokeColor=#44546A;strokeWidth=1.4;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PRODUCT" target="LINE_ITEM"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c223" value="Constraints and notes (T-SQL)&#xa;CUSTOMER:  UNIQUE (EmailAddress) as alternate key;  DEFAULT constraints on City (&#x27;Dallas&#x27;), State (&#x27;TX&#x27;), ZIP (&#x27;75201&#x27;).&#xa;IDENTITY:  CustomerID and SeminarID use IDENTITY(1,1);  InvoiceNumber uses IDENTITY(35000,1).&#xa;INVOICE:  PaymentType DEFAULT &#x27;Cash&#x27;;  CHECK (PaymentType IN (&#x27;VISA&#x27;, &#x27;MasterCard&#x27;, &#x27;American Express&#x27;, &#x27;PayPal&#x27;, &#x27;Check&#x27;, &#x27;Cash&#x27;)).&#xa;CONTACT:  CHECK (ContactType IN (&#x27;Seminar&#x27;, &#x27;FormLetterSeminar&#x27;, &#x27;WebAccountCreation&#x27;, &#x27;WebPurchase&#x27;, &#x27;EmailAccountMessage&#x27;, &#x27;EmailSeminarMessage&#x27;, &#x27;EmailPurchaseMessage&#x27;, &#x27;EmailExchangeMessage&#x27;, &#x27;PhoneConversation&#x27;)).&#xa;PRODUCT:  CHECK (ProductType IN (&#x27;Video&#x27;, &#x27;Video Companion&#x27;, &#x27;Book&#x27;)).&#xa;ContactNumber (per customer) and LineNumber (per invoice) restart at 1 and are supplied by application logic, so they are not IDENTITY.&#xa;Legend:  teal header = entity table,  orange header = junction / dependent table,  NN = NOT NULL,  AK = alternate (unique) key." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F5F8FA;strokeColor=#B8C4CF;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontStyle=0;strokeWidth=1;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="705" width="1740" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>